# ── Purl AI Backend — Environment Variables ────────────────────────────────
# Copy this file to `.env` and adjust:  cp .env.example .env
# All variables are optional — sensible defaults are defined in app/config.py.

# ── LLM provider (optional — MOCK mode when no API key) ─────────────────────
# Leave LLM_API_KEY empty to run in MOCK mode:
# the backend generates a local HTML design without any API calls.
# This is great for local development and CI.
#
# LLM_PROVIDER selects a preset: openai | openrouter | groq | deepseek |
# gemini | ollama | anthropic | custom. Custom uses LLM_BASE_URL + LLM_MODEL
# verbatim (any OpenAI-compatible endpoint).
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# ── Database ────────────────────────────────────────────────────────────────
# Defaults to a local SQLite file next to the backend.
DATABASE_URL=sqlite+aiosqlite:///./purl.db

# ── Auth ────────────────────────────────────────────────────────────────────
# ⚠️  CHANGE THIS in any deployed environment (use: openssl rand -hex 32)
JWT_SECRET=dev-secret-purl-32-bytes-minimum-!!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Rate limiting (requests per hour) ───────────────────────────────────────
RATE_LIMIT_ANON=100
RATE_LIMIT_FREE=500

# ── CORS — JSON array of allowed origins ────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# ── Limits / cache ──────────────────────────────────────────────────────────
MAX_PROMPT_LENGTH=2000
FREE_ITERATIONS_LIMIT=10
CACHE_TTL_SECONDS=86400
