# ── Purl AI Backend — Environment Variables ────────────────────────────────
# Copy this file to `.env` and adjust:  cp .env.example .env
# All variables are optional — sensible defaults are defined in app/config.py.

# ── LLM provider (optional — MOCK mode when no keys) ────────────────────────
# LLM_PROVIDER selects the default/Auto provider and owns LLM_API_KEY.
# Leave all API keys empty to run in MOCK mode: the backend generates a local
# HTML design without any API calls. Great for local development and CI.
#
# LLM_PROVIDER selects a preset: openai | openrouter | groq | deepseek |
# gemini | ollama | anthropic | custom. Custom uses LLM_BASE_URL + LLM_MODEL
# verbatim (any OpenAI-compatible endpoint).
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# ── Per-provider API keys (optional) ────────────────────────────────────────
# These keys enable their own provider in the model picker. They are sent only
# to that provider's endpoint; LLM_API_KEY is never forwarded to another one.
# Ollama needs no key. CUSTOM_API_KEY is for the `custom` preset and requires
# LLM_BASE_URL (or LLM_FALLBACK_BASE_URL for a fallback).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_API_KEY=

# ── Fallback LLM provider (optional) ────────────────────────────────────────
# "provider:model" used for one retry when the primary provider fails before
# any content is streamed. Providers match the LLM_PROVIDER presets, plus
# `custom`. Examples: openrouter:openai/gpt-4o | ollama:llama3.2 | custom:my-model
LLM_FALLBACK_MODEL=

# API key for the fallback endpoint. Empty uses the fallback provider's own
# key (or LLM_API_KEY only when the fallback targets LLM_PROVIDER);
# Ollama never needs a key.
LLM_FALLBACK_API_KEY=

# Base URL for the fallback endpoint. Required for `custom` unless LLM_BASE_URL
# is set; an optional override for presets otherwise.
LLM_FALLBACK_BASE_URL=
# Retry semantics: one fallback attempt, and only for network/timeout errors
# and HTTP 408/429/500/502/503/504 that occur before the first content chunk.
# Auth errors, other 4xx, and mid-stream failures surface unchanged. The
# fallback is skipped when it resolves to the same endpoint as the primary.

# ── Instance protection (optional) ──────────────────────────────────────────
# When set, every /api/* route requires `Authorization: Bearer <token>`.
# GET /health and GET /api/instance stay public. Empty = open instance (default).
# Use a long random value, e.g. `openssl rand -hex 32`, and serve over HTTPS.
INSTANCE_TOKEN=

# ── Database ────────────────────────────────────────────────────────────────
# Defaults to a local SQLite file next to the backend.
DATABASE_URL=sqlite+aiosqlite:///./purl.db

# ── Rate limiting (requests per hour per client IP) ─────────────────────────
RATE_LIMIT_PER_HOUR=100

# ── CORS — JSON array of allowed origins ────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# ── Limits / cache ──────────────────────────────────────────────────────────
MAX_PROMPT_LENGTH=2000
CACHE_TTL_SECONDS=86400
